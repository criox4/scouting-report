# Solana: Helius (https://helius.dev, free tier works). Backup is used when the primary runs out of credits.
HELIUS_API_KEY=
HELIUS_API_KEY_BACKUP=
# EVM chains (BNB, Ethereum, Base, Arbitrum, Polygon): dRPC (https://drpc.org). Same failover.
DRPC_KEY=
DRPC_KEY_BACKUP=
# AI assessment: any OpenAI-compatible endpoint. AI_MODEL is an ordered fallback list.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Where the SQLite file lives (Docker: /data volume). Defaults to ./.cache
# DATA_DIR=
